# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/archnext
# Or if using Supabase: postgresql+asyncpg://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Security
SECRET_KEY=your_super_secret_jwt_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# Blockchain
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology/
NFT_CONTRACT_ADDRESS=0xYourDeployedNFTContractAddress
MARKETPLACE_ADDRESS=0xYourDeployedMarketplaceAddress

# AI / ML
# GOOGLE_APPLICATION_CREDENTIALS=path/to/key.json (If using GCP)
OPENAI_API_KEY=sk-your-openai-key-for-dalle-or-text

# Email Services (SMTP)
# If left blank, OTPs and recovery links will print to the backend console instead.
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
